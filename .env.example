# Optional Rust service for real AI analysis. No key is needed for demo mode.
# RUST_API_URL=http://127.0.0.1:8080

# Google OAuth 2.0 (создайте Web Application в Google Cloud Console -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (и на Render: https://<your-app>.onrender.com/api/auth/callback/google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTH_SECRET=random-32-character-secret-key-for-session-signing

# Optional: override public URL if behind specific proxies
# NEXT_PUBLIC_APP_URL=https://your-domain.com
